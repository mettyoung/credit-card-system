{
  "priority": 2,
  "request": {
    "method": "POST",
    "urlPath": "/v3.6/checks",
    "bodyPatterns": [
      {
        "matchesJsonPath": {
          "expression": "$.applicant_id",
          "equalTo": "apl_timeout"
        }
      }
    ]
  },
  "response": {
    "status": 201,
    "headers": {
      "Content-Type": "application/json"
    },
    "transformers": [
      "response-template"
    ],
    "jsonBody": {
      "id": "chk_timeout_{{randomValue type='UUID'}}",
      "status": "in_progress",
      "result": null,
      "report_ids": [
        "rpt_timeout"
      ]
    }
  }
}
