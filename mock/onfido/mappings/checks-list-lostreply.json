{
  "priority": 1,
  "request": {
    "method": "GET",
    "urlPath": "/v3.6/checks",
    "queryParameters": {
      "applicant_id": {
        "equalTo": "apl_lostreply"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "checks": [
        {
          "id": "chk_clear_lostreply_{{randomValue type='UUID'}}",
          "status": "in_progress",
          "result": null,
          "report_ids": [
            "rpt_clear"
          ]
        }
      ]
    },
    "transformers": [
      "response-template"
    ]
  }
}
