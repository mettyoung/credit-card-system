# Copy to .env (git-ignored) and fill in. Used by compose.deploy.yaml.

# Zero Trust -> Networks -> Tunnels -> your tunnel -> Docker; the string after --token.
CLOUDFLARE_TUNNEL_TOKEN=

POSTGRES_DB=creditcard
POSTGRES_USER=creditcard
POSTGRES_PASSWORD=

MINIO_ROOT_USER=creditcard
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=credit-card-documents

# Once the custom domain exists, e.g. https://app.example.com and https://s3.example.com (see DEPLOY.md).
PUBLIC_APP_URL=http://localhost:8080
S3_PUBLIC_ENDPOINT=

# Loopback port for checking the app on this Mac (8080 is left free for ./gradlew bootRun).
APP_LOCAL_PORT=8088
APP_UI_TIMELINE_ENABLED=false
